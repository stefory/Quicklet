<Window x:Class="Quicklet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quicklet" 
        Height="Auto" 
        Width="600"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- 默认声明的主题资源占位，防止编译报错 -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E20"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2E2E32"/>
        <SolidColorBrush x:Key="SubBackgroundBrush" Color="#2E2E32"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E4E4E7"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="PlaceholderBrush" Color="#5E5E62"/>
        <SolidColorBrush x:Key="SelectedItemBackgroundBrush" Color="#2A2A2D"/>
        <SolidColorBrush x:Key="MouseOverItemBackgroundBrush" Color="#252528"/>
        <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#19191B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
        
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Margin="15" 
            Background="{DynamicResource WindowBackgroundBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="12"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="3" Opacity="0.4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" x:Name="DividerRow"/>
                <RowDefinition Height="Auto" x:Name="ListRow"/>
                <RowDefinition Height="Auto" x:Name="FooterRow"/>
            </Grid.RowDefinitions>

            <!-- 1. 搜索输入区 -->
            <Grid Grid.Row="0" Margin="16,18,16,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 放大镜图标 -->
                <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                      Fill="{DynamicResource PlaceholderBrush}" 
                      Width="18" Height="18" 
                      Stretch="Uniform" 
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"/>

                <!-- 输入框 -->
                <TextBox x:Name="SearchInput" 
                         Grid.Column="1"
                         Background="Transparent" 
                         BorderThickness="0" 
                         Foreground="{DynamicResource TextBrush}" 
                         CaretBrush="{DynamicResource AccentBrush}" 
                         FontSize="20" 
                         FontWeight="SemiBold"
                         FontFamily="Segoe UI, Microsoft YaHei"
                         VerticalAlignment="Center"
                         TextChanged="SearchInput_TextChanged"/>

                <!-- 占位符提示 -->
                <TextBlock x:Name="PlaceholderText"
                           Grid.Column="1"
                           Text="输入关键字打开网页，或直接输入搜索..." 
                           Foreground="{DynamicResource PlaceholderBrush}" 
                           FontSize="20"
                           FontFamily="Segoe UI, Microsoft YaHei"
                           IsHitTestVisible="False" 
                           VerticalAlignment="Center"
                           Margin="2,0,0,0"/>

                <!-- 状态徽章 -->
                <Border Grid.Column="2" 
                        Background="{DynamicResource SubBackgroundBrush}" 
                        CornerRadius="4" 
                        Padding="8,3" 
                        VerticalAlignment="Center">
                    <TextBlock Text="Quicklet" 
                               Foreground="{DynamicResource MutedTextBrush}" 
                               FontSize="13" 
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- 2. 分割线 -->
            <Border x:Name="Divider" 
                    Grid.Row="1" 
                    Height="1" 
                    Background="{DynamicResource BorderBrush}" 
                    Visibility="Collapsed"/>

            <!-- 3. 建议列表 -->
            <ListBox x:Name="SuggestionList" 
                     Grid.Row="2" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     MaxHeight="260"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     SelectionMode="Single"
                     Visibility="Collapsed"
                     MouseDoubleClick="SuggestionList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="16,10"/>
                        <Setter Property="Margin" Value="4,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border CornerRadius="6" 
                                            Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectedItemBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MouseOverItemBackgroundBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 图标 -->
                            <Path x:Name="ItemIcon" 
                                  Grid.Column="0" 
                                  Width="14" Height="14" 
                                  Fill="{Binding IconColor}" 
                                  Data="{Binding IconData}" 
                                  Stretch="Uniform" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,12,0"/>

                            <!-- 文本 -->
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding DisplayName}" 
                                       Foreground="{DynamicResource TextBrush}" 
                                       FontSize="14" 
                                       FontFamily="Segoe UI, Microsoft YaHei"
                                       VerticalAlignment="Center"/>

                            <!-- 触发词徽章 -->
                            <Border Grid.Column="2" 
                                    Background="{DynamicResource SubBackgroundBrush}" 
                                    CornerRadius="4" 
                                    Padding="5,1,5,2" 
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding BadgeText}" 
                                           Foreground="{DynamicResource MutedTextBrush}" 
                                           FontSize="11" 
                                           FontFamily="Consolas, Segoe UI"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 4. 页脚提示 -->
            <Border x:Name="Footer" 
                    Grid.Row="3" 
                    Background="{DynamicResource FooterBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="0,1,0,0" 
                    CornerRadius="0,0,12,12" 
                    Padding="16,8"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tab 补全 • Enter 打开 • Esc 隐藏" 
                               Foreground="{DynamicResource PlaceholderBrush}" 
                               FontSize="11" 
                               FontFamily="Segoe UI, Microsoft YaHei"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="打开" 
                                   Foreground="{DynamicResource MutedTextBrush}" 
                                   FontSize="11" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,4,0"/>
                        <Border Background="{DynamicResource SubBackgroundBrush}" CornerRadius="3" Padding="4,1">
                            <TextBlock Text="↵" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
